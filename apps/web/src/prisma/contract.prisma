// use prisma-8

// ─── Users & Auth ──────────────────────────────────────────────────────────

// Tabla "user" de better-auth (login). El rol lo maneja el plugin admin:
// 'admin' | 'mecanico' | 'user' (cliente). Las columnas de auth (emailVerified,
// banReason, etc.) se omiten porque solo las toca better-auth.
model User {
  id        String  @id
  name      String
  email     String  @unique
  role      String?
  phone     String?
  banned    Boolean?

  assignedOrders WorkOrder[]        @relation("assignedMechanic")
  timeLogs       WorkOrderTimeLog[]
  quotesCreated  Quote[]            @relation("quoteCreatedBy")
  quotesAnswered Quote[]            @relation("quoteRespondedBy")
  pushTokens     PushToken[]
  notifications  Notification[]
  ownershipsMade VehicleOwnership[]

  createdAt TimestamptzString

  @@map("user")
}

// ─── Customers ─────────────────────────────────────────────────────────────

model Customer {
  id      String  @id @default(uuid())
  name    String
  phone   String
  email   String?
  address String?
  notes   String?

  vehicles            Vehicle[]
  workOrders          WorkOrder[]
  vehicleOwnerships   VehicleOwnership[]
  appointments        Appointment[]
  assistanceRequests  AssistanceRequest[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// Cada tramo de trabajo de un mecánico sobre una orden (Iniciar → Pausar/Terminar).
// endedAt null = el mecánico está trabajando esa orden ahora mismo.
model WorkOrderTimeLog {
  id          String            @id @default(uuid())
  workOrderId String
  mechanicId  String
  startedAt   TimestamptzString @default(now())
  endedAt     TimestamptzString?
  note        String?

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  mechanic    User      @relation(fields: [mechanicId], references: [id])

  createdAt TimestamptzString @default(now())
}

// ─── Vehicles ──────────────────────────────────────────────────────────────

model Vehicle {
  id           String  @id @default(uuid())
  customerId   String
  make         String
  model        String
  year         Int
  licensePlate String  @unique
  vin          String?
  color        String?
  mileage      Int     @default(0)

  customer     Customer      @relation(fields: [customerId], references: [id])
  workOrders   WorkOrder[]
  appointments Appointment[]
  ownerships   VehicleOwnership[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ─── Work Orders ───────────────────────────────────────────────────────────

enum WorkOrderStatus {
  pending
  assigned
  in_progress
  quality_check
  completed
  cancelled
}

model WorkOrder {
  id               String          @id @default(uuid())
  customerId       String
  vehicleId        String?
  mechanicId       String?
  status           WorkOrderStatus @default(pending)
  complaint        String
  diagnosis        String?
  estimatedCost    Float?
  actualCost       Float?
  notes            String?
  completedAt      TimestamptzString?
  startedAt        TimestamptzString?
  mileageIn        Int?

  customer            Customer            @relation(fields: [customerId], references: [id])
  vehicle             Vehicle?            @relation(fields: [vehicleId], references: [id])
  mechanic            User?               @relation("assignedMechanic", fields: [mechanicId], references: [id])
  serviceItems        ServiceLineItem[]
  partItems           PartLineItem[]
  assistanceRequests  AssistanceRequest[]
  timeLogs            WorkOrderTimeLog[]
  quotes              Quote[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model ServiceLineItem {
  id          String    @id @default(uuid())
  workOrderId String
  description String
  cost        Float     @default(0)
  quoteItemId String?

  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])
  quoteItem   QuoteItem? @relation(fields: [quoteItemId], references: [id])

  createdAt TimestamptzString @default(now())
}

// ─── Inventory ─────────────────────────────────────────────────────────────

model SparePart {
  id             String  @id @default(uuid())
  partNumber     String  @unique
  name           String
  category       String?
  quantity       Int     @default(0)
  minimumStock   Int     @default(5)
  purchasePrice  Float   @default(0)
  sellingPrice   Float   @default(0)
  supplier       String?
  location       String?
  description    String?

  partLineItems  PartLineItem[]
  quoteItems     QuoteItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model PartLineItem {
  id          String    @id @default(uuid())
  workOrderId String
  sparePartId String?
  name        String
  quantity    Float     @default(1)
  unitPrice   Float     @default(0)
  totalPrice  Float     @default(0)
  quoteItemId String?

  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id])
  sparePart   SparePart? @relation(fields: [sparePartId], references: [id])
  quoteItem   QuoteItem? @relation(fields: [quoteItemId], references: [id])

  createdAt TimestamptzString @default(now())
}

// ─── Appointments ──────────────────────────────────────────────────────────

enum AppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

model Appointment {
  id          String            @id @default(uuid())
  customerId  String
  vehicleId   String?
  scheduledAt TimestamptzString
  duration    Int               @default(60)
  serviceType String
  notes       String?
  status      AppointmentStatus @default(scheduled)
  reminderSentAt TimestamptzString?

  customer    Customer  @relation(fields: [customerId], references: [id])
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// ─── Services & Schedule ────────────────────────────────────────────────────

model ServiceType {
  id              String  @id @default(uuid())
  name            String
  description     String?
  durationMinutes Int     @default(60)
  active          Boolean @default(true)
  price           Float?

  createdAt       TimestamptzString @default(now())
}

model WorkSchedule {
  id        String  @id @default(uuid())
  dayOfWeek Int     @unique
  startHour Int     @default(8)
  endHour   Int     @default(17)
  active    Boolean @default(false)
}

// ─── Assistance ─────────────────────────────────────────────────────────────

model AssistanceType {
  id          String  @id @default(uuid())
  name        String
  description String?
  active      Boolean @default(true)

  requests    AssistanceRequest[]

  createdAt   TimestamptzString @default(now())
}

model AssistanceRequest {
  id                String  @id @default(uuid())
  customerId        String?
  assistanceTypeId  String?
  detail            String
  phone             String
  latitude          Float?
  longitude         Float?
  status            String  @default("pending")
  workOrderId       String?

  customer          Customer?        @relation(fields: [customerId], references: [id])
  assistanceType    AssistanceType?  @relation(fields: [assistanceTypeId], references: [id])
  workOrder         WorkOrder?       @relation(fields: [workOrderId], references: [id])

  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()
}

// ─── Cotizaciones ──────────────────────────────────────────────────────────

// status: draft → sent → approved | partially_approved | rejected
model Quote {
  id            String  @id @default(uuid())
  workOrderId   String
  status        String  @default("draft")
  notes         String?
  taxRate       Float   @default(0.15)
  createdById   String?
  sentAt        TimestamptzString?
  respondedAt   TimestamptzString?
  respondedById String?
  respondedVia  String?
  responseNote  String?

  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id])
  createdBy   User?       @relation("quoteCreatedBy", fields: [createdById], references: [id])
  respondedBy User?       @relation("quoteRespondedBy", fields: [respondedById], references: [id])
  items       QuoteItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// kind: service | part · priority: urgent | recommended | optional · decision: pending | approved | rejected
model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  position    Int     @default(0)
  kind        String  @default("service")
  description String
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  priority    String  @default("recommended")
  sparePartId String?
  decision    String  @default("pending")
  decidedAt   TimestamptzString?

  quote        Quote             @relation(fields: [quoteId], references: [id])
  sparePart    SparePart?        @relation(fields: [sparePartId], references: [id])
  serviceLines ServiceLineItem[]
  partLines    PartLineItem[]

  createdAt TimestamptzString @default(now())
}

// ─── Notificaciones ────────────────────────────────────────────────────────

model PushToken {
  id       String  @id @default(uuid())
  userId   String
  token    String  @unique
  platform String?

  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Notification {
  id     String  @id @default(uuid())
  userId String
  type   String
  title  String
  body   String
  url    String?
  readAt TimestamptzString?

  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
}

// ─── Historial de dueños ───────────────────────────────────────────────────

// endedAt null = dueño actual (hay uno solo por vehículo)
model VehicleOwnership {
  id          String  @id @default(uuid())
  vehicleId   String
  customerId  String
  startedAt   TimestamptzString @default(now())
  endedAt     TimestamptzString?
  createdById String?
  note        String?

  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  createdAt TimestamptzString @default(now())
}
